<Window x:Class="ScreenHealthGuardian.Views.AlertOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screen Health Guardian Alert"
        Height="400" Width="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Opacity="0"
        KeyDown="Window_KeyDown">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0.0" To="0.97" Duration="0:0:0.3" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border Background="{StaticResource Brush.Surface.Canvas}"
            BorderBrush="{StaticResource Brush.Border.Subtle}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="35,25">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Emoji Icon Badge -->
            <Border x:Name="EmojiBadge"
                    Grid.Row="0"
                    Width="68" Height="68"
                    CornerRadius="34"
                    Background="{StaticResource Brush.Surface.Card}"
                    BorderBrush="{StaticResource Brush.Border.Subtle}"
                    BorderThickness="1.5"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,10">
                <TextBlock x:Name="EmojiBlock"
                           Text="👀"
                           FontSize="32"
                           Foreground="{StaticResource Brush.Text.Primary}"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Segoe UI Emoji">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1.5" Direction="315" Opacity="0.85" />
                    </TextBlock.Effect>
                </TextBlock>
            </Border>

            <!-- Title -->
            <TextBlock x:Name="TitleBlock"
                       Grid.Row="1"
                       Text="Rest Your Eyes"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{StaticResource Brush.Accent.Primary}"
                       HorizontalAlignment="Center"
                       FontFamily="Segoe UI"
                       Margin="0,0,0,8" />

            <!-- Message -->
            <TextBlock x:Name="MessageBlock"
                       Grid.Row="2"
                       Text="Look at an object at least 20 feet (6m) away for 20 seconds to reduce eye strain."
                       FontSize="13"
                       Foreground="{StaticResource Brush.Text.Secondary}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="Segoe UI"
                       MaxWidth="480"
                       Margin="0,0,0,15" />

            <!-- Action Buttons: Snooze & Dismiss -->
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,10">
                <Button x:Name="SnoozeButton"
                        Content="Snooze (5m)"
                        Click="SnoozeButton_Click"
                        Style="{StaticResource ModernDarkButton}"
                        Padding="20,9"
                        FontSize="12"
                        Margin="0,0,12,0" />

                <Button x:Name="DismissButton"
                        Content="I'm looking away (Done)"
                        Click="DismissButton_Click"
                        Style="{StaticResource ModernPrimaryButton}"
                        Padding="24,9"
                        FontSize="12"
                        FontWeight="Bold"
                        IsDefault="True" />
            </StackPanel>

            <!-- Countdown Progress & Label -->
            <StackPanel Grid.Row="4" Margin="0,5,0,0">
                <ProgressBar x:Name="AutoDismissProgress"
                             Height="4"
                             Foreground="{StaticResource Brush.Accent.Primary}"
                             Background="{StaticResource Brush.Surface.Control}"
                             BorderThickness="0" />
                <TextBlock x:Name="AutoDismissLabel"
                           Text="30s"
                           FontSize="11"
                           Foreground="{StaticResource Brush.Text.Secondary}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
