<Window x:Class="ScreenHealthGuardian.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screen Health Guardian — Preferences"
        Height="620" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0b0e14"
        Foreground="#ffffff"
        FontFamily="Segoe UI">

    <Grid Margin="25,15,25,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock x:Name="HeaderTitle"
                       Text="Preferences &amp; Settings"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#ffffff" />
            <TextBlock x:Name="HeaderSubtitle"
                       Text="Customize interval timers, alerts, and system behaviors"
                       FontSize="11"
                       Foreground="#8b949e"
                       Margin="0,3,0,0" />
        </StackPanel>

        <!-- Main Settings Cards -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Card 1: Intervals -->
                <Border Background="#161b22"
                        BorderBrush="#30363d"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18,14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="SecIntervalsLabel"
                                   Text="TIMER INTERVALS"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#4fc3f7"
                                   Margin="0,0,0,10" />

                        <!-- Eye Rest -->
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="35" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="EyeRestLabel" Text="Eye Rest Interval:" VerticalAlignment="Center" Foreground="#c9d1d9" />
                            <TextBox x:Name="TxtLookAway" Grid.Column="1" Width="55" Height="26" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#21262d" Foreground="#ffffff" BorderBrush="#30363d" />
                            <TextBlock Grid.Column="2" Text="min" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#8b949e" />
                        </Grid>

                        <!-- Posture -->
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="35" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PostureLabel" Text="Posture Check Interval:" VerticalAlignment="Center" Foreground="#c9d1d9" />
                            <TextBox x:Name="TxtPosture" Grid.Column="1" Width="55" Height="26" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#21262d" Foreground="#ffffff" BorderBrush="#30363d" />
                            <TextBlock Grid.Column="2" Text="min" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#8b949e" />
                        </Grid>

                        <!-- Idle -->
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="35" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="IdleLabel" Text="Idle Inactivity Reset:" VerticalAlignment="Center" Foreground="#c9d1d9" />
                            <TextBox x:Name="TxtIdle" Grid.Column="1" Width="55" Height="26" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#21262d" Foreground="#ffffff" BorderBrush="#30363d" />
                            <TextBlock Grid.Column="2" Text="min" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#8b949e" />
                        </Grid>

                        <!-- Dismiss -->
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="35" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DismissLabel" Text="Auto-dismiss Timeout:" VerticalAlignment="Center" Foreground="#c9d1d9" />
                            <TextBox x:Name="TxtDismiss" Grid.Column="1" Width="55" Height="26" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#21262d" Foreground="#ffffff" BorderBrush="#30363d" />
                            <TextBlock Grid.Column="2" Text="sec" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#8b949e" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 2: System Preferences -->
                <Border Background="#161b22"
                        BorderBrush="#30363d"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18,14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="SecPreferencesLabel"
                                   Text="SYSTEM &amp; PREFERENCES"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#b388ff"
                                   Margin="0,0,0,10" />

                        <!-- Sound Checkbox -->
                        <CheckBox x:Name="ChkSound"
                                  Content="Play notification sound"
                                  Foreground="#c9d1d9"
                                  Margin="0,6" />

                        <!-- Autostart Checkbox -->
                        <CheckBox x:Name="ChkAutoStart"
                                  Content="Start on Windows login"
                                  Foreground="#c9d1d9"
                                  Margin="0,6" />

                        <!-- Language Dropdown -->
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LanguageLabel" Text="Language:" VerticalAlignment="Center" Foreground="#c9d1d9" />
                            <ComboBox x:Name="CmbLanguage"
                                      Grid.Column="1"
                                      Background="#21262d"
                                      Foreground="#ffffff">
                                <ComboBoxItem Content="English" Tag="en" />
                                <ComboBoxItem Content="Español" Tag="es" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Screen Health Guardian v1.0.0"
                       VerticalAlignment="Center"
                       FontSize="10"
                       Foreground="#484f58" />

            <Button x:Name="BtnCancel"
                    Grid.Column="1"
                    Content="Cancel"
                    Click="BtnCancel_Click"
                    Background="#21262d"
                    Foreground="#c9d1d9"
                    BorderThickness="0"
                    Padding="16,6"
                    Margin="0,0,10,0"
                    Cursor="Hand" />

            <Button x:Name="BtnSave"
                    Grid.Column="2"
                    Content="Save Preferences"
                    Click="BtnSave_Click"
                    Background="#4fc3f7"
                    Foreground="#0b0e14"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Padding="18,6"
                    Cursor="Hand" />
        </Grid>
    </Grid>
</Window>
