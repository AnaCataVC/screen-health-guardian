---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<main class="max-w-5xl mx-auto px-6 py-20 flex flex-col items-center text-center">
  <!-- Hero Section -->
  <header class="animate-fade-in-up mt-10 md:mt-20">
    <div class="inline-flex items-center justify-center px-4 py-1.5 mb-8 text-sm font-medium rounded-full glass text-sky-400 border-sky-500/30 shadow-[0_0_15px_rgba(14,165,233,0.15)]">
      <span class="relative flex h-2 w-2 mr-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-sky-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-sky-500"></span>
      </span>
      {t('badge.available')}
    </div>
    
    <img src="/icon.png" alt="Screen Health Guardian Logo" class="w-24 h-24 mx-auto mb-6 drop-shadow-[0_0_20px_rgba(14,165,233,0.4)] transition-transform hover:scale-105 duration-300" />

    <h1 class="text-5xl md:text-7xl font-bold tracking-tight mb-6 bg-gradient-to-br from-white to-slate-400 bg-clip-text text-transparent">
      {t('hero.title')} <br/> 
      <span class="text-sky-400 bg-gradient-to-r from-sky-400 to-sky-200 bg-clip-text text-transparent">
        {t('hero.subtitle')}
      </span>
    </h1>
    
    <p class="text-lg md:text-xl text-slate-400 max-w-2xl mx-auto mb-12 leading-relaxed">
      {t('hero.description')}
    </p>
    
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="https://github.com/AnaCataVC/screen-health-guardian/releases" class="px-8 py-4 rounded-xl font-semibold bg-sky-500 text-white hover:bg-sky-400 transition-all shadow-[0_0_20px_rgba(14,165,233,0.3)] hover:shadow-[0_0_30px_rgba(14,165,233,0.5)] transform hover:-translate-y-1 duration-200">
        {t('button.download')}
      </a>
      <a href="https://github.com/AnaCataVC/screen-health-guardian" target="_blank" class="px-8 py-4 rounded-xl font-semibold glass glass-hover transition-all text-white flex items-center justify-center gap-2 transform hover:-translate-y-1 duration-200">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path></svg>
        {t('button.repo')}
      </a>
    </div>
  </header>

  <!-- Content Section -->
  <section class="mt-20 md:mt-32 w-full animate-fade-in-up flex flex-col gap-20 md:gap-32" style="animation-delay: 0.2s; animation-fill-mode: both;">
    
    <!-- Feature 1: Eyes with WPF Overlay Mockup -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">
      <div class="order-2 lg:order-1 w-full">
        <div class="glass p-6 md:p-12 rounded-3xl flex flex-col gap-6 text-left relative overflow-hidden group border border-slate-700/50 hover:border-blue-500/30 transition-colors">
          <div class="absolute inset-0 bg-gradient-to-br from-blue-500/5 to-transparent opacity-100"></div>
          <div class="relative z-10 w-16 h-16 bg-blue-500/20 text-blue-400 rounded-2xl flex items-center justify-center text-3xl shadow-[0_0_20px_rgba(59,130,246,0.2)]">
            👀
          </div>
          <h2 class="relative z-10 text-3xl md:text-4xl font-bold">{t('feature1.title')}</h2>
          <p class="relative z-10 text-slate-400 leading-relaxed text-lg">{t('feature1.desc')}</p>
        </div>
      </div>
      
      <!-- Mockup 1: WPF Alert Overlay (Eye Rest) -->
      <div class="order-1 lg:order-2 w-full">
        <div class="relative p-1 rounded-3xl bg-gradient-to-b from-sky-500/20 to-blue-500/5 shadow-2xl">
          <div class="bg-[#0f0f23]/95 backdrop-blur-xl border border-[#292b4a] rounded-[22px] p-6 sm:p-8 text-center flex flex-col items-center justify-center relative overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.6)]">
            
            <!-- Window subtle glow -->
            <div class="absolute -top-10 left-1/2 -translate-x-1/2 w-40 h-20 bg-sky-500/10 blur-2xl rounded-full pointer-events-none"></div>

            <!-- Emoji -->
            <div class="text-5xl mb-3 select-none transform hover:scale-110 transition-transform">
              👀
            </div>

            <!-- Title -->
            <h3 class="text-xl sm:text-2xl font-bold text-[#4fc3f7] mb-2 font-sans tracking-wide">
              {t('mockup.eyes.title')}
            </h3>

            <!-- Message -->
            <p class="text-xs sm:text-sm text-[#b0bec5] max-w-sm mb-6 leading-relaxed">
              {t('mockup.eyes.msg')}
            </p>

            <!-- WPF Dark Button -->
            <div class="w-full max-w-xs">
              <button type="button" class="w-full py-2.5 px-6 rounded-lg font-bold text-xs sm:text-sm text-white bg-[#21262d] hover:bg-[#30363d] border border-[#388bfd] hover:border-[#4fc3f7] transition-all shadow-md active:scale-98 cursor-default">
                {t('mockup.eyes.btn')}
              </button>
            </div>

            <!-- Animated Auto-dismiss Progress Bar -->
            <div class="w-full bg-[#1b1c36] h-1.5 rounded-full mt-6 overflow-hidden relative">
              <div class="bg-[#4fc3f7] h-full rounded-full w-2/3 shadow-[0_0_10px_#4fc3f7] animate-pulse"></div>
            </div>
            <div class="flex justify-between w-full mt-1.5 text-[10px] text-slate-500 font-mono">
              <span>Auto-dismiss in 20s</span>
              <span>WPF Overlay</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Feature 2: Posture with WPF Overlay Mockup -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">
      <!-- Mockup 2: WPF Alert Overlay (Posture) -->
      <div class="order-1 w-full">
        <div class="relative p-1 rounded-3xl bg-gradient-to-b from-sky-500/20 to-teal-500/5 shadow-2xl">
          <div class="bg-[#0f0f23]/95 backdrop-blur-xl border border-[#292b4a] rounded-[22px] p-6 sm:p-8 text-center flex flex-col items-center justify-center relative overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.6)]">
            
            <div class="absolute -top-10 left-1/2 -translate-x-1/2 w-40 h-20 bg-teal-500/10 blur-2xl rounded-full pointer-events-none"></div>

            <!-- Emoji -->
            <div class="text-5xl mb-3 select-none transform hover:scale-110 transition-transform">
              🧘
            </div>

            <!-- Title -->
            <h3 class="text-xl sm:text-2xl font-bold text-[#4fc3f7] mb-2 font-sans tracking-wide">
              {t('mockup.posture.title')}
            </h3>

            <!-- Message -->
            <p class="text-xs sm:text-sm text-[#b0bec5] max-w-sm mb-6 leading-relaxed">
              {t('mockup.posture.msg')}
            </p>

            <!-- WPF Dark Button -->
            <div class="w-full max-w-xs">
              <button type="button" class="w-full py-2.5 px-6 rounded-lg font-bold text-xs sm:text-sm text-white bg-[#21262d] hover:bg-[#30363d] border border-[#388bfd] hover:border-[#4fc3f7] transition-all shadow-md active:scale-98 cursor-default">
                {t('mockup.posture.btn')}
              </button>
            </div>

            <!-- Auto-dismiss countdown bar -->
            <div class="w-full bg-[#1b1c36] h-1.5 rounded-full mt-6 overflow-hidden relative">
              <div class="bg-[#4fc3f7] h-full rounded-full w-4/5 shadow-[0_0_10px_#4fc3f7]"></div>
            </div>
            <div class="flex justify-between w-full mt-1.5 text-[10px] text-slate-500 font-mono">
              <span>Interval: 45 min</span>
              <span>Hardware-Accelerated</span>
            </div>
          </div>
        </div>
      </div>

      <div class="order-2 w-full">
        <div class="glass p-6 md:p-12 rounded-3xl flex flex-col gap-6 text-left relative overflow-hidden group border border-slate-700/50 hover:border-sky-500/30 transition-colors">
          <div class="absolute inset-0 bg-gradient-to-br from-sky-500/5 to-transparent opacity-100"></div>
          <div class="relative z-10 w-16 h-16 bg-sky-500/20 text-sky-400 rounded-2xl flex items-center justify-center text-3xl shadow-[0_0_20px_rgba(14,165,233,0.2)]">
            ✨
          </div>
          <h2 class="relative z-10 text-3xl md:text-4xl font-bold">{t('feature2.title')}</h2>
          <p class="relative z-10 text-slate-400 leading-relaxed text-lg">{t('feature2.desc')}</p>
        </div>
      </div>
    </div>

    <!-- Feature 3: Configuration & Smart Detection with Settings Window Mockup -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">
      <div class="order-2 lg:order-1 w-full">
        <div class="glass p-6 md:p-12 rounded-3xl flex flex-col gap-6 text-left relative overflow-hidden group border border-slate-700/50 hover:border-purple-500/30 transition-colors">
          <div class="absolute inset-0 bg-gradient-to-br from-purple-500/5 to-transparent opacity-100"></div>
          <div class="relative z-10 flex gap-4">
            <div class="w-16 h-16 bg-purple-500/20 text-purple-400 rounded-2xl flex items-center justify-center text-3xl shadow-[0_0_20px_rgba(168,85,247,0.2)] shrink-0">
              ⚙️
            </div>
          </div>
          <h2 class="relative z-10 text-3xl md:text-4xl font-bold">{t('config.combined_title')}</h2>
          <p class="relative z-10 text-slate-400 leading-relaxed text-lg">{t('feature3.desc')}</p>
        </div>
      </div>

      <!-- Mockup 3: WPF Fluent Settings Window -->
      <div class="order-1 lg:order-2 w-full">
        <div class="relative p-1 rounded-3xl bg-gradient-to-b from-purple-500/20 to-blue-500/5 shadow-2xl">
          <div class="bg-[#0b0e14] border border-[#30363d] rounded-[22px] p-5 sm:p-6 text-left relative overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.6)] font-sans text-xs sm:text-sm">
            
            <!-- Window Title Bar -->
            <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-800/80">
              <div class="flex items-center gap-2">
                <img src="/icon.png" class="w-4 h-4" alt="Icon" />
                <span class="text-white font-semibold text-xs">{t('mockup.settings.title')}</span>
              </div>
              <div class="flex gap-1.5">
                <span class="w-2.5 h-2.5 rounded-full bg-slate-700"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-slate-700"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></span>
              </div>
            </div>

            <!-- Card 1: Timer Intervals -->
            <div class="bg-[#161b22] border border-[#30363d] rounded-xl p-3.5 mb-3">
              <div class="text-[10px] font-bold text-[#4fc3f7] tracking-wider mb-2.5">
                {t('mockup.settings.intervals')}
              </div>
              <div class="space-y-2">
                <div class="flex items-center justify-between">
                  <span class="text-slate-200 text-xs">{t('mockup.settings.eye_interval')}</span>
                  <div class="flex items-center gap-1.5">
                    <span class="bg-[#21262d] border border-[#388bfd] text-white px-2.5 py-0.5 rounded text-xs font-semibold text-center w-12">20</span>
                    <span class="text-slate-400 text-[10px]">min</span>
                  </div>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-slate-200 text-xs">{t('mockup.settings.posture_interval')}</span>
                  <div class="flex items-center gap-1.5">
                    <span class="bg-[#21262d] border border-[#388bfd] text-white px-2.5 py-0.5 rounded text-xs font-semibold text-center w-12">45</span>
                    <span class="text-slate-400 text-[10px]">min</span>
                  </div>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-slate-200 text-xs">{t('mockup.settings.idle_interval')}</span>
                  <div class="flex items-center gap-1.5">
                    <span class="bg-[#21262d] border border-[#388bfd] text-white px-2.5 py-0.5 rounded text-xs font-semibold text-center w-12">2</span>
                    <span class="text-slate-400 text-[10px]">min</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Card 2: System Preferences -->
            <div class="bg-[#161b22] border border-[#30363d] rounded-xl p-3.5 mb-4">
              <div class="text-[10px] font-bold text-[#b388ff] tracking-wider mb-2.5">
                {t('mockup.settings.sec_system')}
              </div>
              <div class="space-y-2">
                <label class="flex items-center gap-2 text-xs text-slate-200 cursor-pointer">
                  <input type="checkbox" checked disabled class="accent-sky-500 rounded" />
                  <span>{t('mockup.settings.sound')}</span>
                </label>
                <label class="flex items-center gap-2 text-xs text-slate-200 cursor-pointer">
                  <input type="checkbox" checked disabled class="accent-sky-500 rounded" />
                  <span>{t('mockup.settings.autostart')}</span>
                </label>
              </div>
            </div>

            <!-- Footer Action Buttons -->
            <div class="flex items-center justify-between pt-1">
              <span class="text-[10px] text-[#8b949e] font-mono">{t('mockup.settings.version')}</span>
              <div class="flex gap-2">
                <button type="button" class="px-3 py-1 rounded-md text-xs font-semibold bg-[#21262d] text-slate-300 border border-[#30363d] cursor-default">
                  {t('mockup.settings.cancel')}
                </button>
                <button type="button" class="px-3 py-1 rounded-md text-xs font-semibold bg-[#388bfd] hover:bg-[#4fc3f7] text-white shadow-sm transition-colors cursor-default">
                  {t('mockup.settings.save')}
                </button>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>

  </section>

  <!-- Footer -->
  <footer class="mt-32 pt-8 pb-8 border-t border-slate-800/50 w-full text-slate-500 text-sm flex justify-center items-center">
    <p>© {new Date().getFullYear()} {t('footer.dev')} <a href="https://ana-catalina.com" target="_blank" class="text-sky-400 hover:text-sky-300 transition-colors font-medium">Ana-Catalina</a>.</p>
  </footer>
</main>

<style>
  .animate-fade-in-up {
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
